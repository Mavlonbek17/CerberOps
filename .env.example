# CerberOps Configuration
# Copy this file to .env and adjust values

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=cerberops
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=cerberops
DATABASE_URL=postgresql+asyncpg://cerberops:changeme_in_production@localhost:5432/cerberops

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Ollama (Local AI) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ── API Security ─────────────────────────────────────────
# Generated automatically on first run if empty
API_KEY=

# ── Scanner Defaults ─────────────────────────────────────
NMAP_TIMEOUT=600
NUCLEI_TIMEOUT=900
ZAP_TIMEOUT=1200
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# ── General ──────────────────────────────────────────────
LOG_LEVEL=INFO
ALLOW_INTERNAL_TARGETS=false
WORKERS=2
